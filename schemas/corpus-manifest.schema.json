{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-manifest.schema.json",
  "title": "Strands AgentGuard CorpusManifest",
  "description": "Frozen manifest for a versioned set of synthetic scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "version",
    "frozen",
    "frozen_at",
    "provenance",
    "confidence",
    "synthetic",
    "real_data",
    "scenario_schema",
    "scenario_count",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "AG-THREAT-CORPUS"
    },
    "version": {
      "const": "0.1.0"
    },
    "frozen": {
      "const": true
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "const": "authored_for_strands_agentguard"
    },
    "confidence": {
      "const": "designed_not_executed"
    },
    "synthetic": {
      "const": true
    },
    "real_data": {
      "const": false
    },
    "scenario_schema": {
      "const": "schemas/scenario.schema.json"
    },
    "scenario_count": {
      "type": "integer",
      "minimum": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "path", "sha256"],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^AG-SCN-[0-9]{3}$"
          },
          "path": {
            "type": "string",
            "pattern": "^fixtures/scenarios/v0\\.1\\.0/ag-scn-[0-9]{3}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
