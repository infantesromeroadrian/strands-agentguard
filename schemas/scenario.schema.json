{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Strands AgentGuard Scenario",
  "description": "Closed v0.1.0 synthetic assessment scenario with a predeclared expected trajectory, outcome, evidence, and cleanup contract.",
  "$comment": "Standard Draft 2020-12 cannot impose lexicographic array order or compare fixture_ref with scenario_id. The canonical contracts.validate_contract_document surface checks relational invariants and returns a model whose set-like arrays are normalized according to x-agentguard-order for persisted output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "version",
    "kind",
    "threat_ids",
    "fixture_ref",
    "provenance",
    "confidence",
    "synthetic",
    "real_data",
    "preconditions",
    "action",
    "expected_trajectory",
    "expected_outcome",
    "forbidden_effects",
    "evidence_required",
    "cleanup",
    "evaluator"
  ],
  "$defs": {
    "eventList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      }
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?($|/))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "safeJsonValue": {
      "anyOf": [
        {"type": ["null", "boolean", "string"]},
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {"type": "number", "not": {"type": "integer"}},
        {"type": "array", "items": {"$ref": "#/$defs/safeJsonValue"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/safeJsonValue"}
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "scenario_id": {"type": "string", "pattern": "^AG-SCN-[0-9]{3}$"},
    "version": {"const": "0.1.0"},
    "kind": {"type": "string", "enum": ["benign", "adversarial", "chaos"]},
    "threat_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-agentguard-order": "lexicographic",
      "items": {"type": "string", "pattern": "^AG-THR-[0-9]{3}$"}
    },
    "fixture_ref": {"$ref": "#/$defs/safeRelativePath"},
    "provenance": {"const": "authored_for_strands_agentguard"},
    "confidence": {"const": "designed_not_executed"},
    "synthetic": {"const": true},
    "real_data": {"const": false},
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "input"],
      "properties": {
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "input": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/safeJsonValue"}
        }
      }
    },
    "expected_trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_order", "forbidden_events"],
      "properties": {
        "required_order": {
          "allOf": [{"$ref": "#/$defs/eventList"}, {"minItems": 1}]
        },
        "forbidden_events": {
          "$ref": "#/$defs/eventList",
          "x-agentguard-order": "lexicographic"
        }
      }
    },
    "expected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "assertions"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 512},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "operator", "value"],
            "properties": {
              "field": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
              "operator": {
                "type": "string",
                "enum": ["absent", "contains", "equals", "less_than_or_equal", "present"]
              },
              "value": {"$ref": "#/$defs/safeJsonValue"}
            }
          }
        }
      }
    },
    "forbidden_effects": {
      "allOf": [{"$ref": "#/$defs/eventList"}],
      "x-agentguard-order": "lexicographic"
    },
    "evidence_required": {
      "allOf": [{"$ref": "#/$defs/eventList"}, {"minItems": 1}],
      "x-agentguard-order": "lexicographic"
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "verify"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "sandbox"]},
        "verify": {"const": true}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic_rules", "semantic"],
      "properties": {
        "deterministic_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-agentguard-order": "lexicographic",
          "items": {"type": "string", "pattern": "^AG-RULE-[0-9]{3}$"}
        },
        "semantic": {"const": false}
      }
    }
  }
}
