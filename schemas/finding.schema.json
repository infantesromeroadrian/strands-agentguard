{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Strands AgentGuard Finding",
  "description": "Closed v0.1.0 evidence-backed finding. Status remains OPEN; disposition is explicit and never inferred from severity.",
  "$comment": "Evidence references are either normalized relative POSIX paths or canonical https:// references with a non-empty hostname, the default port, no userinfo, no query string, no percent encoding, no backslash, and no traversal. Windows drive paths are local and invalid in this normalized contract. Within AssessmentResult, every local reference requires a matching artifact_hashes key; remote HTTPS references intentionally do not. Standard Draft 2020-12 cannot express that cross-document membership, so use contracts.validate_contract_document for full validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "rule_id",
    "requirement_ids",
    "scenario_id",
    "severity",
    "confidence",
    "status",
    "disposition",
    "title",
    "evidence_refs",
    "reproduction",
    "limitations",
    "run_id"
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "nonEmptyText": {"type": "string", "minLength": 1, "maxLength": 1024},
    "evidenceRef": {
      "description": "Normalized relative POSIX local reference (optionally with a fragment) or canonical default-port https:// hostname reference without userinfo, query, percent encoding, backslash, or traversal.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[/\\\\])(?!.*(?:^|[/#])\\.\\.(?:$|[/#]))(?:https://[^\\[\\]:/?#@%\\s\\u0000-\\u001f\\u007f\\\\]+(?:/[^?#%\\s\\u0000-\\u001f\\u007f\\\\]*)?(?:#[^%\\s\\u0000-\\u001f\\u007f\\\\]*)?|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*(?:#[^\\s\\u0000-\\u001f\\u007f\\\\]*)?)$"
    }
  },
  "properties": {
    "finding_id": {"$ref": "#/$defs/safeId"},
    "rule_id": {"type": "string", "pattern": "^AG-RULE-[0-9]{3}$"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-agentguard-order": "lexicographic",
      "items": {"type": "string", "pattern": "^AG-(FR|SEC|NFR|DAT)-[0-9]{3}$"}
    },
    "scenario_id": {"type": "string", "pattern": "^AG-SCN-[0-9]{3}$"},
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "confidence": {
      "type": "string",
      "enum": ["CONFIRMED", "PROBABLE", "POSSIBLE"]
    },
    "status": {"const": "OPEN"},
    "disposition": {
      "enum": [
        null,
        "MITIGATED",
        "ACCEPTED_RISK",
        "FALSE_POSITIVE",
        "DUPLICATE",
        "OUT_OF_SCOPE",
        "NOT_REPRODUCIBLE"
      ]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-agentguard-order": "lexicographic",
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "reproduction": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyText"}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyText"}
    },
    "run_id": {"$ref": "#/$defs/safeId"}
  }
}
