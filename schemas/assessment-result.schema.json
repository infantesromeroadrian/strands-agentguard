{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-result.schema.json",
  "title": "Strands AgentGuard AssessmentResult",
  "description": "Closed v0.1.0 source result with explicit incomplete state and addressable evidence. Every normalized relative POSIX evidence reference requires a matching artifact_hashes entry; canonical remote HTTPS references intentionally require no local artifact hash.",
  "$comment": "Standard Draft 2020-12 cannot express local evidence-to-artifact hash membership, cross-contract references, digest coherence, or lexicographic array ordering. The canonical contracts.validate_contract_document surface checks those invariants and temporal order. Remote evidence is limited to canonical https:// references with a non-empty hostname, the default port, no userinfo, no query string, no percent encoding, no backslash, and no traversal. Windows drive paths are classified as local and rejected because persisted local paths use normalized relative POSIX form. JSON object duplicate keys are rejected by the raw contract parser before schema/model validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_identity",
    "target_id",
    "timestamps",
    "stop_reason",
    "scenario_results",
    "findings",
    "metrics",
    "artifact_hashes",
    "summary"
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "safeReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
    },
    "nonEmptyText": {"type": "string", "minLength": 1, "maxLength": 1024},
    "evidenceRef": {
      "description": "Normalized relative POSIX local reference (optionally with a fragment) or canonical default-port https:// hostname reference without userinfo, query, percent encoding, backslash, or traversal.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[/\\\\])(?!.*(?:^|[/#])\\.\\.(?:$|[/#]))(?:https://[^\\[\\]:/?#@%\\s\\u0000-\\u001f\\u007f\\\\]+(?:/[^?#%\\s\\u0000-\\u001f\\u007f\\\\]*)?(?:#[^%\\s\\u0000-\\u001f\\u007f\\\\]*)?|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*(?:#[^\\s\\u0000-\\u001f\\u007f\\\\]*)?)$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?($|/))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "completed",
        "passed",
        "incomplete_reason",
        "evidence_refs",
        "finding_ids"
      ],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^AG-SCN-[0-9]{3}$"},
        "completed": {"type": "boolean"},
        "passed": {"type": ["boolean", "null"]},
        "incomplete_reason": {
          "anyOf": [{"$ref": "#/$defs/nonEmptyText"}, {"type": "null"}]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "x-agentguard-order": "lexicographic",
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "x-agentguard-order": "lexicographic",
          "items": {"$ref": "#/$defs/safeId"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"completed": {"const": true}}, "required": ["completed"]},
          "then": {
            "properties": {
              "passed": {"type": "boolean"},
              "incomplete_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"completed": {"const": false}}, "required": ["completed"]},
          "then": {
            "properties": {
              "passed": {"type": "null"},
              "incomplete_reason": {"$ref": "#/$defs/nonEmptyText"}
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_identity": {"$ref": "run-identity.schema.json"},
    "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "stop_reason": {"$ref": "#/$defs/safeReason"},
    "scenario_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-agentguard-order": "scenario_id",
      "items": {"$ref": "#/$defs/scenarioResult"}
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "x-agentguard-order": "finding_id",
      "items": {"$ref": "finding.schema.json"}
    },
    "metrics": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9._-]{0,63}$"},
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "artifact_hashes": {
      "description": "SHA-256 by normalized relative POSIX artifact path. Must contain every local evidence path without its fragment; remote evidence URIs are deliberately absent.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safeRelativePath"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "incomplete_reason"],
      "properties": {
        "completed": {"type": "boolean"},
        "incomplete_reason": {
          "anyOf": [{"$ref": "#/$defs/nonEmptyText"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"completed": {"const": true}}, "required": ["completed"]},
          "then": {"properties": {"incomplete_reason": {"type": "null"}}}
        },
        {
          "if": {"properties": {"completed": {"const": false}}, "required": ["completed"]},
          "then": {"properties": {"incomplete_reason": {"$ref": "#/$defs/nonEmptyText"}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["summary"],
        "properties": {
          "summary": {
            "required": ["completed"],
            "properties": {"completed": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "stop_reason": {"const": "assessment completed"},
          "scenario_results": {
            "items": {
              "properties": {"completed": {"const": true}},
              "required": ["completed"]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["summary"],
        "properties": {
          "summary": {
            "required": ["completed"],
            "properties": {"completed": {"const": false}}
          }
        }
      },
      "then": {
        "properties": {
          "stop_reason": {"not": {"const": "assessment completed"}},
          "scenario_results": {
            "contains": {
              "properties": {"completed": {"const": false}},
              "required": ["completed"]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
