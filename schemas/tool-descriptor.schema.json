{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-descriptor.schema.json",
  "title": "Strands AgentGuard ToolDescriptor",
  "description": "Closed v0.1.0 description of one tool. fingerprint is SHA-256 of compact, key-sorted UTF-8 JSON for {name, description, input_schema}, including one terminal LF.",
  "$comment": "input_schema must explicitly declare the exact Draft 2020-12 URI; check_schema alone does not enforce that declaration. The canonical contracts.validate_contract_document surface additionally verifies the fingerprint value against the canonical material. READ_ONLY_ALLOWED plus SIMULATED_WRITE represents the deliberate vulnerable baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "name",
    "description",
    "input_schema",
    "origin",
    "permission_class",
    "effect_class",
    "approval_required",
    "fingerprint"
  ],
  "$defs": {
    "safeJsonValue": {
      "anyOf": [
        {"type": ["null", "boolean", "string"]},
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {"type": "number", "not": {"type": "integer"}},
        {"type": "array", "items": {"$ref": "#/$defs/safeJsonValue"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/safeJsonValue"}
        }
      ]
    }
  },
  "properties": {
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input_schema": {
      "allOf": [
        {"$ref": "https://json-schema.org/draft/2020-12/schema"},
        {"$ref": "#/$defs/safeJsonValue"},
        {
          "type": "object",
          "required": ["$schema", "type", "additionalProperties"],
          "properties": {
            "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
            "type": {"const": "object"},
            "additionalProperties": {"const": false}
          }
        }
      ]
    },
    "origin": {
      "type": "string",
      "enum": ["custom", "mcp", "vended"]
    },
    "permission_class": {
      "type": "string",
      "enum": ["READ_ONLY_ALLOWED", "SIMULATED_SENSITIVE_APPROVAL", "DENIED"]
    },
    "effect_class": {
      "type": "string",
      "enum": ["NONE", "READ", "SIMULATED_WRITE"]
    },
    "approval_required": {"type": "boolean"},
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "permission_class": {"const": "READ_ONLY_ALLOWED"},
        "effect_class": {"const": "READ"},
        "approval_required": {"const": false}
      }
    },
    {
      "properties": {
        "permission_class": {"const": "READ_ONLY_ALLOWED"},
        "effect_class": {"const": "SIMULATED_WRITE"},
        "approval_required": {"const": false}
      }
    },
    {
      "properties": {
        "permission_class": {"const": "SIMULATED_SENSITIVE_APPROVAL"},
        "effect_class": {"const": "SIMULATED_WRITE"},
        "approval_required": {"const": true}
      }
    },
    {
      "properties": {
        "permission_class": {"const": "DENIED"},
        "effect_class": {"const": "NONE"},
        "approval_required": {"const": false}
      }
    }
  ]
}
